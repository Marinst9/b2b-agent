# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already listed in .gitignore). All values below are placeholders.

# --- existing app config -----------------------------------------------------

HUNTER_API_KEY=your-hunter-io-api-key
OPENAI_API_KEY=your-openai-api-key
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=your-mailtrap-username
MAILTRAP_PASSWORD=your-mailtrap-password

# Local dev Postgres used by the FastAPI app directly (from your host machine).
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/b2b_agent

# --- background processing (Celery + Redis) ----------------------------------

# From the HOST machine (e.g. running `celery -A celery_app worker` directly,
# not in a container), this should point at localhost:
CELERY_BROKER_URL=redis://localhost:6379/0

# Bounded exponential backoff + jitter for CELERY-LEVEL retries of transient
# infrastructure failures only (see tasks.py's RETRYABLE_EXCEPTIONS).
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=5
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=120

# Per-task wall-clock budget.
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=90
CELERY_TASK_TIME_LIMIT_SECONDS=120

# How long a producer (API process) waits to connect to the broker before
# giving up and leaving the job for the outbox sweep to retry later.
CELERY_BROKER_CONNECT_TIMEOUT_SECONDS=2

# Periodic maintenance task intervals (seconds), run via `celery beat`.
OUTBOX_SWEEP_INTERVAL_SECONDS=15
LEASE_RECOVERY_INTERVAL_SECONDS=60

# Fleet-wide concurrent external-provider-call budget (OpenAI, outbound HTTP
# fetches), enforced via Redis across all worker processes. NOTE: this is a
# CONCURRENCY limit only ("at most N calls in flight at once") -- it does not
# implement request-rate limiting or a total-usage/cost cap; see
# app/modules/provider_budget.py's module docstring.
PROVIDER_CONCURRENCY_LIMIT=4
PROVIDER_SLOT_TTL_SECONDS=120
PROVIDER_ACQUIRE_TIMEOUT_SECONDS=30

# --- real-broker integration tests (app/tests/integration/) ------------------
# Only used by `pytest tests/integration`, and only ever pointed at the
# DISPOSABLE infra in docker-compose.integration.yml -- never at the values
# above. See app/tests/integration/README.md.

INTEGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/b2b_agent_integration
INTEGRATION_CELERY_BROKER_URL=redis://localhost:6380/0
